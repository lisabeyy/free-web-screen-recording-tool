# LiveKit Cloud (carries your camera / screen to the recorder): https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Mux (records the stream and makes the downloadable MP4)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional cost protection for public deployments
# MAX_SESSIONS_PER_IP_HOUR=6
# MAX_CONCURRENT_RECORDINGS=5
